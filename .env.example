# KarobarSaathi AI - Environment Variables

# Server port (default: 3001)
PORT=3001

# AI Provider Configuration
# Supported values:
#   ocr     - Local Tesseract + Windows OCR only (default, no API key needed)
#   openai  - Local OCR first, falls back to OpenAI GPT-4o Vision when OCR fails
#   google  - Local OCR first, falls back to Google Gemini Vision when OCR fails
#   groq    - Local OCR first, falls back to Groq qwen vision models when OCR fails
AI_PROVIDER=ocr

# OpenAI (when AI_PROVIDER=openai)
# OPENAI_API_KEY=sk-your-key-here
# OPENAI_MODEL=gpt-4o                  # optional — override the model

# Google Gemini (when AI_PROVIDER=google)
# GOOGLE_AI_API_KEY=your-key-here
# GEMINI_MODEL=gemini-3.5-flash        # optional — override the model (auto-fallback to alternate on 503)

# Groq (when AI_PROVIDER=groq)
# Vision-capable models (Llama 3.2 Vision was decommissioned by Groq in April 2025):
#   qwen/qwen3.8-27b (default primary) and qwen/qwen3.6-27b (automatic fallback)
# GROQ_API_KEY=gsk-your-key-here
# GROQ_MODEL=qwen/qwen3.8-27b          # optional — override the vision model
